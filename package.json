{
  "name": "solid-chess",
  "version": "0.1.0",
  "private": true,
  "description": "Playable chess: framework-free rules engine, SolidJS UI with drag-and-drop, online multiplayer over WebSockets.",
  "license": "MIT",
  "author": "scythewyvern",
  "repository": {
    "type": "git",
    "url": "https://github.com/scythewyvern/solid-chess.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "start": "bun run server/ws-server.ts",
    "server": "bun run server/ws-server.ts",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --fix"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@radix-ui/colors": "^3.0.0",
    "@solid-primitives/drag-drop": "^0.1.0-next.0",
    "@solidjs/web": "^2.0.0-rc.4",
    "solid-js": "^2.0.0-rc.4"
  },
  "devDependencies": {
    "@solidjs/diagnostics": "^2.0.0-rc.2",
    "@solidjs/vite-plugin": "^3.0.0-next.36",
    "@types/bun": "^1.4.0",
    "eslint-plugin-solid": "^0.17.0",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "~7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-icons-spritesheet": "^3.1.0"
  }
